{
  "files.eol": "\r\n",
  "files.encoding": "utf8",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/release": true,
    "**/.data": true,
    "**/.tmp": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/release/**": true,
    "**/.data/**": true
  }
}
